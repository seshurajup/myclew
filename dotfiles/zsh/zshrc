# ~/.zshrc — loader only. Real configuration lives in ~/.config/zsh/rc.d/,
# sourced in numeric order:
#
#   00-env.zsh       paths, CUDA/ML environment
#   10-options.zsh   history, completion, key bindings
#   20-tools.zsh     fzf / atuin / zoxide / bat / eza integrations
#   30-ml.zsh        GPU observability, conda/uv, experiment runners
#   40-prompt.zsh    powerlevel10k + live GPU prompt segment
#   50-greeting.zsh  login banner
#
# Add a file, don't grow this one.

# Powerlevel10k instant prompt. Anything that may need console input (password
# prompts, y/n confirmations) must go above this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ----------------------------------------------------------------- oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                       # prompt is powerlevel10k, loaded in 40-prompt
zstyle ':omz:update' mode reminder
DISABLE_UNTRACKED_FILES_DIRTY="true"   # git status stays fast in big data repos

plugins=(
  git
  python
  pip
  conda
  virtualenv
  command-not-found
  extract                          # `x <any archive>`
  zsh-autosuggestions
  zsh-syntax-highlighting          # must stay last
)
source $ZSH/oh-my-zsh.sh

# --------------------------------------------------------------------- conda
# Managed by `conda init`; leave the block shape intact so conda can update it.
# >>> conda initialize >>>
__conda_setup="$('/home/seshu/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/seshu/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/seshu/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/seshu/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

conda activate "${DEFAULT_CONDA_ENV:-llm}"

# ------------------------------------------------------------------ rc.d
for __rc in $HOME/.config/zsh/rc.d/*.zsh(N); do source $__rc; done
unset __rc

# ---------------------------------------------------------------- local
# Machine-specific or secret settings, never committed.
[[ -f $HOME/.zshrc.local ]] && source $HOME/.zshrc.local

autoload -Uz compinit && compinit -C   # -C: trust the dump, skip the security scan

# ── Self-healing: clear stuck mouse-reporting on every prompt ──
# If a program (vim, less, htop, ssh, tmux…) exits uncleanly it can
# leave the terminal in mouse-reporting mode, so moving the mouse
# "types" escape sequences at the prompt. Disabling the modes before
# each prompt guarantees that never persists past one command.
autoload -Uz add-zsh-hook
_prompt_disable_mouse() {
  [[ -t 1 ]] || return                 # only when stdout is a real TTY
  printf "\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1015l"
}
add-zsh-hook precmd _prompt_disable_mouse
